{
  "version": 1,
  "summary": "Reports any commit that lands without having been through bug-hunter.",
  "command": "scripts/check-commit-trailer.sh",
  "default": "enabled",
  "events": {
    "claude": { "event": "PostToolUse", "matcher": "Bash" },
    "cursor": { "event": "postToolUse", "matcher": "Shell" }
  }
}
