{
  "version": 1,
  "default": "enabled",
  "hooks": [
    {
      "summary": "Reports any commit that changes openspec/ and lands without a valid Spec-check: trailer.",
      "command": "scripts/check-commit-trailer.sh",
      "events": {
        "claude": { "event": "PostToolUse", "matcher": "Bash" },
        "cursor": { "event": "postToolUse", "matcher": "Shell" }
      }
    }
  ]
}
